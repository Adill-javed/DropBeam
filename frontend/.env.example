# DropBeam Frontend Environment Variables Example

# The URL of the deployed Spring Boot backend's HTTP API.
# Replace <your-backend-app> with your actual Render application name.
# Example: https://dropbeam-backend.onrender.com/api
VITE_API_URL=https://<your-backend-app>.onrender.com/api

# The URL of the deployed Spring Boot backend's WebSocket/SockJS endpoint.
# Make sure to use the https protocol (SockJS will upgrade this to wss internally).
# Example: https://dropbeam-backend.onrender.com/ws
VITE_WS_URL=https://<your-backend-app>.onrender.com/ws
